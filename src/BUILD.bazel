        "gtest_prod.h",
        "init.h",
        "model_factory.h",
        "model_interface.h",
        "normalizer.h",
        "ret_check.h",
        "sentencepiece_processor.h",
        "unigram_model.h",
        "util.h",
        "word_model.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
