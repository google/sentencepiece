module(
    name = "sentencepiece",
    version = "0.2.3",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
# libsais is compiled from C sources. The Bazel build takes it from the Bazel
# Central Registry; 2.10.4 is the same upstream release the vendored
# third_party/libsais copy is a reformatted snapshot of. The vendored copy is
# still what the CMake build compiles. OpenMP is off by default, as it is in
# libsais' own CMake build; enable it with --@libsais//:openmp on a toolchain
# that supports -fopenmp.
bazel_dep(name = "libsais", version = "2.10.4.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "36.0.bcr.1", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", repo_name = "com_google_googletest")
